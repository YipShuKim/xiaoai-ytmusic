# 服务监听端口
PORT=8080

# 宿主机局域网 IP（强烈建议填写 NAS 的局域网 IP，如 192.168.1.100；留空则自动探测）
# 小爱音箱需要通过此 IP 拉取 NAS 上的 YouTube Music 音频流
LAN_IP=

# 访问 YouTube Music 的 HTTP/HTTPS 代理（如 http://192.168.1.2:7890）
# 注意：仅本容器访问 YouTube 时走此代理，小爱音箱与小米云通信直连不走代理
YTMUSIC_PROXY=

# 数据与缓存持久化目录
DATA_DIR=/app/data

# 管理后台访问密码（留空则免密访问）
ADMIN_PASSWORD=

# 外部 Bot 调用 API Key（兼容 ytmusic-bridge 接口，留空不校验）
API_KEY=

# 音频缓存上限（MB）与过期时间（小时）
MAX_CACHE_MB=1024
CACHE_TTL_HOURS=72
